# Database
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-random-secret"

# GitHub OAuth App - human login
GITHUB_OAUTH_CLIENT_ID="your-github-oauth-client-id"
GITHUB_OAUTH_CLIENT_SECRET="your-github-oauth-client-secret"

# GitHub App - repository execution
GITHUB_APP_ID="your-github-app-id"
GITHUB_PRIVATE_KEY_PATH="/absolute/path/to/your-github-app-private-key.pem"

# Internal platform operations
AGENTBOUNTY_INTERNAL_KEY="replace-with-a-random-internal-key"
